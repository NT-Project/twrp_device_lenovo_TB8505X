/dev/block/platform/bootdevice/by-name/system      /system    ext4    ro,errors=panic                                              wait
/dev/block/platform/bootdevice/by-name/vendor      /vendor    ext4    ro,errors=panic                                              wait

/dev/block/platform/bootdevice/by-name/userdata    /data      ext4    noatime,nosuid,nodev,noauto_da_alloc,errors=panic,nobarrier   wait,check,quota,reservedsize=200M,formattable,resize
/dev/block/platform/bootdevice/by-name/cache       /cache     ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                  wait,check,formattable

/dev/block/platform/bootdevice/by-name/metadata    /metadata  ext4    defaults                                                     wait
/dev/block/platform/bootdevice/by-name/persist     /persist   ext4    defaults                                                     wait
/dev/block/platform/bootdevice/by-name/nvdata      /nvdata    ext4    defaults                                                     wait

/dev/block/platform/bootdevice/by-name/boot        /boot      emmc    defaults                                                     defaults
/dev/block/platform/bootdevice/by-name/recovery    /recovery  emmc    defaults                                                     defaults
/dev/block/platform/bootdevice/by-name/vbmeta      /vbmeta    emmc    defaults                                                     defaults
/dev/block/platform/bootdevice/by-name/dtbo        /dtbo      emmc    defaults                                                     defaults
/dev/block/platform/bootdevice/by-name/para        /misc      emmc    defaults                                                     defaults

/devices/platform/externdevice*                    /external_sd auto  defaults                                                     voldmanaged=sdcard1:auto
/devices/platform/mt_usb*                          /usb_otg     auto  defaults                                                     voldmanaged=usbotg:auto
