service sys_vold /system_root/system/bin/vold \
        --blkid_context=u:r:blkid:s0 \
        --blkid_untrusted_context=u:r:blkid_untrusted:s0 \
        --fsck_context=u:r:fsck:s0 \
        --fsck_untrusted_context=u:r:fsck_untrusted:s0
    socket vold stream 0660 root mount
    socket cryptd stream 0660 root mount
    setenv PATH /system_root/system/bin:/system/bin:/vendor/bin
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/system_root/system/lib64/vndk-sp-29:/system_root/system/lib64/vndk-29:/system_root/system/lib:/vendor/lib64:/vendor/lib:/system/lib64:/system/lib
    seclabel u:r:recovery:s0
    disabled
    oneshot
