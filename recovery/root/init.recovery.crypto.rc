#
# TB-8505X recovery crypto bootstrap v2
# Microtrust TEE + stock HIDL + Beanpod Keymaster
#

service recovery_teei_daemon /vendor/bin/teei_daemon \
    -r 020b0000000000000000000000000000 \
    -r 020f0000000000000000000000000000 \
    -r 06090000000000000000000000000000 \
    -r 05120000000000000000000000000000 \
    -r 40188311faf343488db888ad39496f9a \
    -r 07060000000000000000000000007169 \
    -r 9073f03a9618383bb1856eb3f990babd \
    -r 08050000000000000000000000003419 \
    -r 5020170115e016302017012521300000 \
    -r 0f5eed3c3b5a47afacca69a84bf0efad \
    -r 07407000000000000000000000000000 \
    -r 05160000000000000000000000000000 \
    -r 91dba524a6e24909acc48abd7163121a \
    -t 08030000000000000000000000000000 \
    -t 85f630e0f0964c5fa2cc268ce04e3da3 \
    -t 98fb95bcb4bf42d26473eae48690d7ea \
    -t 7b66512021214487ba710a51d7ea78fe \
    -t 09010000000000000000000000000000
    class core
    user system
    group system
    seclabel u:r:recovery:s0
    disabled

service recovery_stock_hwservicemanager /system_root/system/bin/hwservicemanager
    class core
    user root
    group root system
    setenv PATH /system_root/system/bin:/system/bin:/vendor/bin
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/system_root/system/lib64/vndk-sp-29:/system_root/system/lib64/vndk-29:/system_root/system/lib:/vendor/lib64:/vendor/lib
    seclabel u:r:recovery:s0
    disabled

service recovery_teei_capi /vendor/bin/hw/vendor.microtrust.hardware.capi@2.0-service
    class core
    user root
    group root system
    setenv PATH /system_root/system/bin:/system/bin:/vendor/bin
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/system_root/system/lib64/vndk-sp-29:/system_root/system/lib64/vndk-29:/system_root/system/lib:/vendor/lib64:/vendor/lib
    seclabel u:r:recovery:s0
    disabled

service vendor.keymaster-4-0-beanpod /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    class default
    user system
    group system drmrpc
    setenv PATH /system_root/system/bin:/system/bin:/vendor/bin
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/system_root/system/lib64/vndk-sp-29:/system_root/system/lib64/vndk-29:/system_root/system/lib:/vendor/lib64:/vendor/lib
    seclabel u:r:recovery:s0
    disabled
    oneshot

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class default
    user system
    group system
    setenv PATH /system_root/system/bin:/system/bin:/vendor/bin
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/system_root/system/lib64/vndk-sp-29:/system_root/system/lib64/vndk-29:/system_root/system/lib:/vendor/lib64:/vendor/lib
    seclabel u:r:recovery:s0
    disabled
    oneshot

service auto_decrypt /sbin/sh /sbin/auto_decrypt.sh
    class default
    user root
    group root system mount
    seclabel u:r:recovery:s0
    oneshot
